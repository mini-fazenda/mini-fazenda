{
  "rules": {
    ".read": false,
    ".write": false,
    "farms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['sessionId','revision','state','saveId','updatedAt']) && newData.child('sessionId').val() === root.child('sessions').child($uid).val() && newData.child('revision').isNumber() && ((!data.child('revision').exists() && newData.child('revision').val() === 1) || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1))",
        "sessionId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "revision": {
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".validate": "newData.hasChildren(['version','moedas','playerXP','playerLevel','COLS','ROWS','player'])",
          "moedas": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "playerXP": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "playerLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "farmName": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "COLS": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 100"
          },
          "ROWS": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 100"
          }
        }
      }
    },
    "publicFarms": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['state','updatedAt','revision']) && newData.child('state/farmName').isString() && newData.child('state/farmName').val().length <= 12 && newData.parent().parent().child('farms').child($uid).child('state').exists() && newData.child('revision').isNumber() && ((newData.child('revision').val() === newData.parent().parent().child('farms').child($uid).child('revision').val()) || (!newData.parent().parent().child('farms').child($uid).child('revision').exists() && newData.child('revision').val() === 0)) && (!newData.parent().parent().child('farms').child($uid).child('saveId').exists() || newData.child('saveId').val() === newData.parent().parent().child('farms').child($uid).child('saveId').val())"
      }
    },
    "directory": {
      ".read": "auth != null && query.orderByKey && query.limitToFirst != null && query.limitToFirst > 0 && query.limitToFirst <= 31",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name','level','updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && $code.matches(/^[0-9]{6}$/)"
      }
    },
    "userCodes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.isString() && root.child('codes').child(newData.val()).val() === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','level','xp','code','updatedAt']) && newData.child('code').val() === root.child('userCodes').child($uid).val()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "code": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && newData.exists() && !root.child('friends').child($to).child($from).exists()) || ((auth.uid === $to || auth.uid === $from) && !newData.exists()))",
          ".validate": "newData.hasChildren(['name','code','level','at']) && newData.child('code').val() === root.child('userCodes').child($from).val()",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "code": {
            ".validate": "newData.isString()"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && $uid !== $other && ((auth.uid === $uid && (!newData.exists() || root.child('friendRequests').child($uid).child($other).exists())) || (auth.uid === $other && (!newData.exists() || root.child('friendRequests').child($other).child($uid).exists())))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "fertUsage": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$owner": {
          ".validate": "newData.hasChildren(['start','n']) && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 5 && newData.child('start').isNumber() && newData.child('start').val() <= now + 60000 && (!data.exists() || (newData.child('start').val() === data.child('start').val() && newData.child('n').val() === data.child('n').val() + 1) || (newData.child('start').val() >= data.child('start').val() + 86400000 && newData.child('n').val() === 1))",
          "start": {
            ".validate": "newData.isNumber()"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "fertilize": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$from": {
          "$id": {
            ".write": "auth != null && ((auth.uid === $from && $from !== $owner && newData.exists() && !data.exists() && root.child('friends').child($owner).child($from).exists()) || (auth.uid === $owner && !newData.exists()))",
            ".validate": "newData.hasChildren(['gx','gy','at','name']) && (newData.parent().parent().parent().parent().child('fertUsage').child($from).child($owner).child('n').val() !== root.child('fertUsage').child($from).child($owner).child('n').val() || newData.parent().parent().parent().parent().child('fertUsage').child($from).child($owner).child('start').val() !== root.child('fertUsage').child($from).child($owner).child('start').val()) && newData.hasChild('key') && (!root.child('fertilizedPlots').child($owner).child(newData.child('key').val()).exists() || root.child('fertilizedPlots').child($owner).child(newData.child('key').val()).child('at').val() + 43200000 <= now) && newData.parent().parent().parent().parent().child('fertilizedPlots').child($owner).child(newData.child('key').val()).child('event').val() === $id",
            "gx": {
              ".validate": "newData.isNumber()"
            },
            "gy": {
              ".validate": "newData.isNumber()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "$other": {
              ".validate": false
            },
            "key": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{1,180}$/)"
            }
          }
        }
      }
    },
    "clock": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },
    "fertilizedPlots": {
      "$owner": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && (!data.exists() || data.child('at').val() + 43200000 <= now) && newData.exists() && auth.uid !== $owner && root.child('friends').child($owner).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['gx','gy','at','name','from','event']) && newData.child('from').val() === auth.uid && $key.matches(/^[a-zA-Z0-9_-]{1,180}$/) && newData.parent().parent().parent().child('fertilize').child($owner).child(auth.uid).child(newData.child('event').val()).child('key').val() === $key && $key === 'block_' + newData.child('gx').val() + '_' + newData.child('gy').val()",
          "gx": {
            ".validate": "newData.isNumber()"
          },
          "gy": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "from": {
            ".validate": "newData.isString()"
          },
          "event": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "adminInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cmd": {
          ".write": "(auth != null && (auth.token.email === 'bielz09.lulu@gmail.com' || auth.token.email === 'fortekmarquez@gmail.com') && auth.token.email_verified === true && newData.exists() && !data.exists()) || (auth != null && auth.uid === $uid && data.exists() && !newData.exists() && root.child('farms').child($uid).child('state/devTools/receipts').child($cmd).val() === true)",
          ".validate": "newData.hasChildren(['type','from','by','at']) && newData.child('type').val().matches(/^(moedas|xp|fertilizar|fertilizar_infinito|fertilizar_infinito_off|crescer)$/) && ((newData.child('type').val() === 'moedas' && newData.child('amount').isNumber() && newData.child('amount').val() >= 1 && newData.child('amount').val() <= 1000000000) || (newData.child('type').val() === 'xp' && newData.child('amount').isNumber() && newData.child('amount').val() >= 1 && newData.child('amount').val() <= 10000000) || (newData.child('type').val() !== 'moedas' && newData.child('type').val() !== 'xp' && !newData.hasChild('amount'))) && newData.child('by').val() === auth.uid && (newData.child('from').val() === root.child('farms').child(auth.uid).child('state/farmName').val() || (newData.child('from').val() === 'Dev' && (!root.child('farms').child(auth.uid).child('state/farmName').exists() || root.child('farms').child(auth.uid).child('state/farmName').val() === '')))",
          "type": {
            ".validate": "newData.isString()"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0"
          },
          "from": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          },
          "by": {
            ".validate": "newData.isString()"
          }
        }
      }
    },
    "adminLog": {
      ".read": "auth != null && (auth.token.email === 'bielz09.lulu@gmail.com' || auth.token.email === 'fortekmarquez@gmail.com') && auth.token.email_verified === true",
      "$id": {
        ".write": "auth != null && (auth.token.email === 'bielz09.lulu@gmail.com' || auth.token.email === 'fortekmarquez@gmail.com') && auth.token.email_verified === true && newData.exists() && !data.exists()",
        ".validate": "newData.hasChildren(['to','by','type','at']) && newData.child('by').val() === auth.uid",
        "to": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "toName": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.isString()"
        },
        "amount": {
          ".validate": "newData.isNumber()"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
