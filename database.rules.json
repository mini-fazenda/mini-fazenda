{
  "rules": {
    ".read": false,
    ".write": false,
    "farms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['sessionId','revision','state','saveId','updatedAt']) && newData.child('sessionId').val() === root.child('sessions').child($uid).val() && newData.child('revision').isNumber() && ((!data.exists() && newData.child('revision').val() === 1) || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1))",
        "sessionId": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "revision": {
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".validate": "newData.hasChildren(['version','moedas','playerXP','playerLevel','COLS','ROWS','player'])",
          "moedas": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "playerXP": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "playerLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "farmName": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "COLS": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 100"
          },
          "ROWS": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 100"
          }
        }
      }
    },
    "publicFarms": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['state','updatedAt']) && newData.child('state/farmName').isString() && newData.child('state/farmName').val().length <= 12"
      }
    },
    "directory": {
      ".read": "auth != null && query.orderByKey && query.limitToFirst != null && query.limitToFirst > 0 && query.limitToFirst <= 31",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['name','level','updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString() && $code.matches(/^[0-9]{6}$/)"
      }
    },
    "userCodes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.isString() && root.child('codes').child(newData.val()).val() === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','level','xp','code','updatedAt']) && newData.child('code').val() === root.child('userCodes').child($uid).val()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "code": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && newData.exists() && !root.child('friends').child($to).child($from).exists()) || ((auth.uid === $to || auth.uid === $from) && !newData.exists()))",
          ".validate": "newData.hasChildren(['name','code','level','at']) && newData.child('code').val() === root.child('userCodes').child($from).val()",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "code": {
            ".validate": "newData.isString()"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && $uid !== $other && ((auth.uid === $uid && (!newData.exists() || root.child('friendRequests').child($uid).child($other).exists())) || (auth.uid === $other && (!newData.exists() || root.child('friendRequests').child($other).child($uid).exists())))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "fertUsage": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['start','n']) && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 5 && newData.child('start').isNumber() && newData.child('start').val() <= now + 60000 && (!data.exists() || (newData.child('start').val() === data.child('start').val() && newData.child('n').val() === data.child('n').val() + 1) || (newData.child('start').val() >= data.child('start').val() + 86400000 && newData.child('n').val() === 1))",
        "start": {
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "fertilize": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$from": {
          "$id": {
            ".write": "auth != null && ((auth.uid === $from && $from !== $owner && newData.exists() && !data.exists() && root.child('friends').child($owner).child($from).exists()) || (auth.uid === $owner && !newData.exists()))",
            ".validate": "newData.hasChildren(['gx','gy','at','name']) && (newData.parent().parent().parent().parent().child('fertUsage').child($from).child('n').val() !== root.child('fertUsage').child($from).child('n').val() || newData.parent().parent().parent().parent().child('fertUsage').child($from).child('start').val() !== root.child('fertUsage').child($from).child('start').val())",
            "gx": {
              ".validate": "newData.isNumber()"
            },
            "gy": {
              ".validate": "newData.isNumber()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}